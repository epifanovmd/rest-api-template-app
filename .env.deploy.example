# Настройки деплоя (скопировать в .env.deploy). Формат make: КЛЮЧ=значение, без кавычек и `$`.
# Любое значение можно переопределить в команде: make deploy SSH_HOST=1.2.3.4

SSH_HOST=example.com
SSH_USER=root
SSH_PROJECT_DIR=development/rest-api
# Опции ssh/scp/rsync (по умолчанию — таймаут, повтор соединения, keepalive):
# SSH_OPTS=-o ConnectTimeout=15 -o ConnectionAttempts=5 -o ServerAliveInterval=30

# Секреты приложения на хосте
ENV_FILE=.env.production

# Состав стека: свои Redis, Postgres и S3 — файлы redis/postgres/s3; общая
# инфраструктура хоста (репозиторий infra) — только docker-compose.infra.yml
# (учётки проекта в ENV_FILE). Без s3-файла — STORAGE_DRIVER=local или внешний S3
COMPOSE_FILES=docker-compose.yml docker-compose.redis.yml docker-compose.postgres.yml docker-compose.s3.yml
# COMPOSE_FILES=docker-compose.yml docker-compose.infra.yml
# Дополнительные сервисы по профилям через запятую; пусто — без них
COMPOSE_PROFILES=

# Образ из registry (make release)
IMAGE=ghcr.io/epifanovmd/rest-api-template-app

# База для db-dump / db-restore; DB_DUMP_FILE — файл дампа (по умолчанию — новый / самый свежий)
DB_CONTAINER=rest-api-postgres-1
DB_USER=postgres
DB_NAME=postgres
DB_DUMP_FILE=
