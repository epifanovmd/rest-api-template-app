# Локальный production-стек (make local-up): api, worker, migrate и свои Postgres, Redis, S3
# в Docker. make local-up копирует этот файл в .env.docker, если его нет; правки — в .env.docker.
# Полный список переменных — .env.example.
APP_PUBLIC_URL=http://localhost:8181
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_SECRET_KEY=local-docker-secret-key-0123456789abcdef
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=local-admin-password

POSTGRES_DB=rest_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# S3 (SeaweedFS) стека; порт на этой машине — для ссылок на файлы из браузера
S3_ROOT_SECRET_KEY=storage12345
S3_PORTS=8335
S3_PUBLIC_ENDPOINT=http://localhost:8335
