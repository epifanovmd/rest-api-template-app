# Копия для окружения: .env.development (yarn dev) или .env.production (Docker).
# Скомпилированный запуск без NODE_ENV работает как production.

# ─── App / Server ─────────────────────────────────────────────────────────────
APP_NAME=rest-api
# Роль процесса: api (HTTP + сокеты), worker (задачи и cron), all (оба — dev, один инстанс)
APP_ROLE=all
# Публичный URL API — ссылки в письмах и подписанные URL файлов
APP_PUBLIC_URL=http://localhost:8181
PUBLIC_HOST=127.0.0.1
SERVER_HOST=0.0.0.0
SERVER_PORT=8181
# true — за доверенным reverse proxy (IP и протокол клиента из X-Forwarded-*)
TRUST_PROXY=false
# Swagger UI на /api-docs; по умолчанию выключен в production
API_DOCS_ENABLED=
# Дополнительные адреса в servers Swagger через запятую (удалённые стенды)
API_DOCS_SERVERS=

# ─── Хранилище файлов ────────────────────────────────────────────────────────
# local — диск (dev, один хост); s3 — S3-совместимое (AWS, MinIO, Yandex, Selectel)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./files
STORAGE_SIGNED_URL_TTL_SECONDS=3600
S3_BUCKET=
S3_REGION=us-east-1
# Локально (docker-compose.dev.yml, SeaweedFS): http://localhost:8333 и S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
# Публичный адрес хранилища для ссылок на файлы (если API ходит в S3 по
# внутреннему адресу, например http://s3:8333 в compose); пусто — S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Задачи (pg-boss) ────────────────────────────────────────────────────────
JOBS_CONCURRENCY=4
JOBS_SHUTDOWN_TIMEOUT_MS=20000
JOBS_POOL_MAX=4
# Сколько дней хранить завершённые записи задач (статус, результат, лог)
JOBS_RETENTION_DAYS=30

# ─── Наблюдаемость ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
# Bearer-токен для /metrics; пусто — закрывать сетью
METRICS_TOKEN=
SENTRY_DSN=

# ─── Остановка (SIGTERM) ─────────────────────────────────────────────────────
# пауза после /ready → 503 (production: 5000), ожидание in-flight, общий предел
SHUTDOWN_DRAIN_MS=
SHUTDOWN_INFLIGHT_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=45000

# ─── Логи ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=

# ─── Redis (обязателен в production) ─────────────────────────────────────────
# Общие лимиты запросов, presence и Socket.IO между репликами
REDIS_URL=redis://localhost:6379

# ─── Rate limit ───────────────────────────────────────────────────────────────
# Запросов с одного IP за окно; файлы по подписанным ссылкам (/files) не считаются
RATE_LIMIT=1000
RATE_LIMIT_INTERVAL=900000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Через запятую; `*` недопустим в production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# не короче 32 символов: openssl rand -base64 48
JWT_SECRET_KEY=change-me-to-a-random-secret-of-32-plus-chars
# срок access-токена (jsonwebtoken: 15m, 1h; в development по умолчанию 1d) и refresh-токена в днях
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Refresh-токен дополнительно в httpOnly-cookie (веб-клиенты)
AUTH_REFRESH_COOKIE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

# ─── OTP / Reset password ─────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
RESET_PASS_TOKEN_EXPIRE_MINUTES=60
WEB_URL_RESET_PASSWORD=http://localhost:3000/reset-password?token={{token}}

# ─── WebAuthn / Passkeys ──────────────────────────────────────────────────────
WEB_AUTHN_RP_NAME=Test
WEB_AUTHN_RP_HOST=localhost
WEB_AUTHN_RP_SCHEMA=http
WEB_AUTHN_RP_PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rest_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
# PEM CA сервера (если провайдер выдаёт); false — не проверять сертификат (только dev)
POSTGRES_SSL_CA=
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# пул на реплику; сумма по репликам < max_connections Postgres
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_SLOW_QUERY_MS=1000
# применять миграции при старте (под advisory-lock); false — миграции отдельным шагом
DB_MIGRATIONS_RUN=true

# ─── Агенты (agent-sdk, github.com/epifanovmd/agent) ──────────────────────────
# Общий токен регистрации (многоразовый, ≥ 32 символов): агенты compose и dev
# (yarn agent) регистрируются им без создания токена. Пусто — только токены из
# POST /api/v1/agent-enrollment-tokens.
AGENT_BOOTSTRAP_TOKEN=
# Как часто агент присылает статус и метрики (узла и воркеров), мс
AGENT_STATUS_INTERVAL_MS=15000
AGENT_METRICS_INTERVAL_MS=15000
# Точку метрик в историю — не чаще, мс (0 — каждую); сколько хранить историю, часов
AGENT_METRICS_STORE_INTERVAL_MS=60000
AGENT_METRICS_RETENTION_HOURS=168
# Сколько дней хранить события воркеров
AGENT_EVENTS_RETENTION_DAYS=14
# Сколько агент считается на связи после обрыва, мс (убитый агент — offline через столько)
AGENT_OFFLINE_GRACE_MS=3000
# Несколько копий API: общий секрет (≥ 32 символов) пересылки вызовов агентов между
# копиями. Пусто — без пересылки (и без её сервера): вызов в копии без соединения агента —
# 503 AGENT_ELSEWHERE.
AGENT_RELAY_SECRET=
# Внутренний сервер пересылки (POST /internal/agent-relay) — свой порт, не публичный порт
# API; наружу не публиковать. Адрес: 127.0.0.1 — копии на одной машине, 0.0.0.0 — в
# контейнере (копии ходят друг к другу по внутренней сети). У копий на одной машине — разные порты.
AGENT_RELAY_HOST=127.0.0.1
AGENT_RELAY_PORT=8182
# Внутренний адрес сервера пересылки этой копии (http://host:AGENT_RELAY_PORT); пусто —
# AGENT_RELAY_HOST (для 0.0.0.0 — IPv4 машины или контейнера) и AGENT_RELAY_PORT
INSTANCE_URL=
# Откуда бэкенд берёт агента и воркер проверки сети netprobe: релизы GitHub. Новую версию
# бэкенд замечает сам (раз в AGENT_RELEASES_CHECK_INTERVAL_MS) и показывает доступное
# обновление — пересобирать бэкенд не нужно. Репозиторий owner/repo; пусто — не брать из GitHub
AGENT_RELEASES_GITHUB=epifanovmd/agent
# Какие версии брать (semver): ^1 — любые 1.x, новая мажорная версия сама не подхватывается
AGENT_RELEASES_RANGE=^1
# Одна версия по ссылке вместо GitHub (своё зеркало, закреплённая версия): каталог с
# manifest.json, например https://github.com/epifanovmd/agent/releases/download/v1.1.0
AGENT_RELEASES_URL=
# Токен GitHub — только чтобы не упереться в лимит запросов (без него — 60 в час с адреса)
AGENT_RELEASES_TOKEN=
# Как часто проверять новую версию, мс (первая проверка — при старте)
AGENT_RELEASES_CHECK_INTERVAL_MS=3600000
# true — узлы скачивают агента через бэкенд (у узлов нет доступа к GitHub); false — ссылкой на GitHub
AGENT_RELEASES_PROXY=false
# Открытый ключ автора агента (base64): им подписаны агент и netprobe
AGENT_RELEASES_PUBLIC_KEY=9yYblu2wKJnjKccihbJv2lKtbxvqecCnX67u9LmgSuo=
# Архивы папки агента для узлов (yarn agent:pack → agent/bundle; в образе API — свой каталог,
# задан в Dockerfile): по ним ставятся узлы (команда установки, SSH), release/ в нём — сборки
# воркеров проекта для их обновления. Пусто — узлы с API не ставятся
AGENT_BUNDLE_DIR=
# Шифрование значений настроек воркеров в БД (в них бывают ключи и пароли):
# 32 байта hex или base64 (openssl rand -hex 32). Без него значения хранятся как есть;
# заданный ключ терять нельзя — зашифрованные значения без него не прочитать.
AGENT_CONFIGS_KEY=
# Файл с закрытым ключом проекта (agent keygen) на машине сборки образа (docker compose
# build): им agent pack подписывает воркеры проекта. Только путь — сам ключ в .env не кладут
AGENT_SIGNING_KEY_FILE=
# Адрес API для агентов (скрипт и команда установки); пусто — APP_PUBLIC_URL
AGENT_PUBLIC_URL=
# Проверка data событий воркеров по схеме из манифеста: off | log (журнал и пометка в истории) |
# reject (то же, но обработчикам модулей событие не передаётся)
AGENT_VALIDATE_EVENTS=log

# ─── SMTP ─────────────────────────────────────────────────────────────────────
# Пусто — почта выключена: в production отправка отвечает 503, в dev письмо в лог.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, пароль приложения в SMTP_PASS.
# Локально: Mailpit из docker-compose.dev.yml — SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
# true — TLS сразу (465); false — STARTTLS (587) или без шифрования (локально)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Адрес отправителя; по умолчанию SMTP_USER
SMTP_FROM=
