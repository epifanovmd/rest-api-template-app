# syntax=docker/dockerfile:1.7
# Агент в контейнере: Go-агент (PID 1, связь, outbox, супервизор нагрузок) и
# Python-нагрузки (SDK `python/worker_sdk`). По умолчанию — эталонная нагрузка
# `examples.echo_worker` (очередь demo.echo, agent/agent.docker.yaml); свой
# воркер — образом `FROM` этого со своим кодом и конфигурацией.
#
#   docker build -f Dockerfile.agent -t agent .
#   docker run --rm -e AGENT_SERVER_URL=http://api:8181 \
#     -e AGENT_ENROLL_TOKEN=<токен регистрации> -v agent-data:/var/lib/agent agent
#
# Обновление — новым образом (update.mode=external); учётные данные — в томе
# /var/lib/agent (без тома агент регистрируется заново при каждом старте).
ARG GO_VERSION=1.26
ARG PYTHON_VERSION=3.12-slim

# ── Сборка агента под платформу образа ───────────────────────────────────────
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS agent-build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY agent/go.mod agent/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY agent/ ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w -X main.version=$(cat VERSION)" -o /out/agent ./cmd/agent

# ── Runtime: Python + агент ──────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    AGENT_CONFIG=/etc/agent/agent.yaml \
    AGENT_DATA_DIR=/var/lib/agent \
    AGENT_UPDATE_MODE=external

WORKDIR /app

COPY python/requirements.txt ./
RUN pip install -r requirements.txt

COPY python/worker_sdk ./worker_sdk
COPY python/examples ./examples
COPY agent/agent.docker.yaml /etc/agent/agent.yaml
COPY --from=agent-build /out/agent /usr/local/bin/agent

RUN useradd --system --uid 10001 --home-dir /app agent && \
    mkdir -p /var/lib/agent && chown agent /var/lib/agent
USER agent
VOLUME ["/var/lib/agent"]

# SIGTERM: агент перестаёт брать задачи, нагрузки дорабатывают текущие
# (stopTimeout в конфигурации); stop_grace_period оркестратора — не меньше.
STOPSIGNAL SIGTERM
ENTRYPOINT ["agent"]
CMD ["run"]
