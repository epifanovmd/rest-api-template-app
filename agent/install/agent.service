# Агент (протокол ALP): связь с бэкендом, нагрузки, самообновление.
# Ставится install.sh; TimeoutStopSec — не меньше самой долгой доработки задач.
[Unit]
Description=Agent (ALP)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__USER__
EnvironmentFile=-/etc/agent/agent.env
# Откат обновления делает прежняя версия до запуска новой: так откатывается и
# версия, падающая до main (после 3 запусков без связи с сервером).
Environment=AGENT_BOOT_GUARD=external
ExecStartPre=-/bin/sh -c '[ ! -x /opt/agent/bin/agent.prev ] || /opt/agent/bin/agent.prev boot-guard /opt/agent/bin/agent'
ExecStart=/opt/agent/bin/agent run -config /etc/agent/agent.yaml
# Перезапуск всегда: и после сбоя, и после самообновления или команды
# agent.restart (агент завершается штатно, менеджер поднимает новую версию).
Restart=always
RestartSec=2
StartLimitIntervalSec=0
# SIGTERM — агенту: он останавливает нагрузки сам (доработка задач);
# по истечении срока systemd добивает всю группу.
KillMode=mixed
TimeoutStopSec=__STOP_TIMEOUT__
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/agent /opt/agent

[Install]
WantedBy=multi-user.target
