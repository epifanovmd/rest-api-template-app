{
  "name": "rest-api",
  "version": "1.0.1",
  "description": "REST API Template App",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "homepage": "https://epifanovmd.github.io/rest-api-template-app",
  "author": {
    "name": "Epifanov Andrei",
    "email": "epifanovmd@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/epifanovmd/rest-api-template-app.git"
  },
  "scripts": {
    "dev": "yarn generate && NODE_ENV=development tsx watch --clear-screen=false src/main.ts",
    "dev:types": "tsc --noEmit --watch --preserveWatchOutput",
    "dev:routes": "nodemon --watch src/modules --ext ts --ignore \"src/routing/routes.ts\" --delay 1 --exec \"yarn generate\"",
    "build": "yarn generate && rm -rf build && tsc -p tsconfig.build.json",
    "server": "NODE_ENV=production node --enable-source-maps build/main.js",
    "generate": "tsoa spec-and-routes",
    "test": "NODE_ENV=test mocha",
    "test:file": "NODE_ENV=test mocha --no-config --require tsx --timeout 10000",
    "test:e2e": "mocha --config .mocharc.e2e.yml",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "prettier:fix": "prettier --write \"src/**/*.ts\"",
    "outdated": "yarn outdated",
    "migration:generate": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "migration:run": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "typecheck": "tsc --noEmit",
    "gen:module": "node scripts/gen-module.mjs",
    "worker:setup": "scripts/python-worker.sh setup",
    "worker": "scripts/python-worker.sh run",
    "prepare": "lefthook install",
    "migration:run:prod": "typeorm migration:run -d build/data-source.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^14",
    "@sentry/node": "^11.0.0",
    "@simplewebauthn/server": "^14",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tsoa/runtime": "6.6.0",
    "bcrypt": "^6.0.0",
    "blurhash": "^2.0.5",
    "ejs": "^6",
    "file-type": "^22.1.1",
    "helmet": "^8",
    "inversify": "^8",
    "ioredis": "^6",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.1",
    "koa-helmet": "^9",
    "koa-ratelimit": "^6",
    "koa2-swagger-ui": "^5.12.0",
    "multer": "^2.4.0",
    "nodemailer": "^10",
    "pg": "^8.23.0",
    "pg-boss": "^12",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "tsoa": "6.6.0",
    "typeorm": "^1.1.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tsoa/cli": "6.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^5.2.3",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9",
    "@types/koa": "^3",
    "@types/koa-ratelimit": "^5.0.5",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__multer": "^2.0.8",
    "@types/koa__router": "^12.0.4",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8",
    "@types/pg": "^8.23.1",
    "@types/sinon": "^22",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "chai": "^6.2.2",
    "eslint": "^10",
    "eslint-plugin-simple-import-sort": "^14",
    "lefthook": "^2",
    "mocha": "^12",
    "nodemon": "^3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3",
    "sinon": "^22",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8"
  },
  "resolutions": {
    "**/@types/koa": "^3.0.3"
  }
}
